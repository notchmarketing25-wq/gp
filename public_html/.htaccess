Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # منع الوصول المباشر لملفات النظام
    RewriteRule ^(app|config|storage|updates)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # الملفات الموجودة فعلاً (uploads / assets) تُخدم مباشرة
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # كل شيء آخر يذهب إلى index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>
